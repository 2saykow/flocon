#!/usr/bin/env bash
# Builds Flocon (NixOS based). Usage: ./build vm | iso
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
command -v nix > /dev/null || { echo "Nix is not installed: sudo pacman -S nix" >&2; exit 1; }
nix() { command nix --extra-experimental-features 'nix-command flakes' "$@"; }

case ${1:-} in
  vm)  nix build .#vm -o result-vm && ./result-vm/bin/run-flocon-vm ;;
  iso) nix build .#iso -o result-iso && ls -lh result-iso/iso/ ;;
  *)   echo "usage: ./build vm | iso" >&2; exit 1 ;;
esac
