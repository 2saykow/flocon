#!/usr/bin/env bash
# Démarre l'ISO Flocon dans une VM avec deux disques vierges (disque1 40 Go, disque2 20 Go) pour tester l'installateur.
cd "$(dirname "$(readlink -f "$0")")"
exec qemu-system-x86_64 -enable-kvm -m 6G -smp 4 -vga std -display gtk \
  -nic user,model=virtio-net-pci -device qemu-xhci -device usb-tablet \
  -cdrom result-iso/iso/flocon-26.05-x86_64.iso -boot once=d \
  -drive file=disque1.img,format=raw,if=virtio -drive file=disque2.img,format=raw,if=virtio
